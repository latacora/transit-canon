{:tasks
 {:requires ([babashka.process :refer [sh]])

  aot
  {:doc "AOT compile gen-class namespaces"
   :task (do
           (shell "mkdir -p classes")
           (clojure "-M:aot"))}

  test
  {:doc "Run tests, passing additional arguments to kaocha"
   :depends [aot]
   :task (apply clojure "-M:dev:test" *command-line-args*)}

  lint
  {:doc "Run clj-kondo linter"
   :task (shell "clj-kondo --lint src test")}

  maint
  {:doc "Check for outdated dependencies and sync clj-kondo configs"
   :task (do
           ;; slf4j-nop silences antq's "Failed to load StaticLoggerBinder"
           ;; warning. Scoped to this invocation only so it stays out of the
           ;; library's published classpath.
           (shell {:continue true} "clojure -Sdeps '{:deps {com.github.liquidz/antq {:mvn/version \"RELEASE\"} org.slf4j/slf4j-nop {:mvn/version \"2.0.17\"}}}' -M -m antq.core")
           (let [cp (-> (sh "clojure" "-Spath" "-A:dev:test") :out)]
             (shell "clj-kondo" "--copy-configs" "--dependencies" "--parallel"
                    "--lint" "src" "test" "--classpath" cp)))}}}
